# This file is intentionally disabled for the first test.
# After the manual workflow is proven, rename it to daily_rotation.yml.

name: Daily Market Rotation

on:
  workflow_dispatch:
  schedule:
    - cron: "30 17 * * 1-5"
      timezone: "America/New_York"

permissions:
  contents: write

concurrency:
  group: market-rotation
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    env:
      AI_PROVIDER: ${{ vars.AI_PROVIDER }}
      GEMINI_MODEL: ${{ vars.GEMINI_MODEL }}
      GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}

    steps:
      - uses: actions/checkout@v5

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: "pip"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Run rotation pipeline
        run: python -m src.run_pipeline

      - name: Commit generated files
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add data/ results/ docs/
          if git diff --cached --quiet; then
            echo "No generated file changes to commit."
          else
            git commit -m "Daily market rotation update"
            git push
          fi
